        { "op": "post", "args": { "entry": "$e1", "at": "2026-12-10T09:00:00+09:00" }, "expect": { "ok": true, "wallet": { "balance": 200, "pending": 0, "nextExpire": [{ "at": "2027-12-11T00:00:00+09:00", "points": 200 }] } } }
