{
  "_doc": "v42 마일리지 기준값. 같은 파일을 didisam/milecalc.js(Node · 브라우저 데모 엔진)와 SQL 함수(mil_*, Node · Java 공용)가 돌려 결과가 같아야 한다. 실행: service/test/mileage42.test.js(runVector), Java 계약은 tests/contract-mileage42.js. 기본값: sid 's1', unit 'lu_root', 정책 base(켜짐 · 12개월 만료 · 마일스톤 없음), 규칙 ver 1 · per_src · trustMin C · auto · achievement. 인자 '$이름'은 앞 단계 결과의 줄 · 신청 ID. expect는 부분 일치(배열은 인덱스별), 시각 문자열은 같은 순간이면 같음.",
  "base": { "policy": { "isOn": true, "expiry": { "mode": "months", "months": 12 }, "streak": { "freezePerWeek": 1, "milestones": [] }, "notice": { "monthsBefore": 6, "daysBefore": [30, 3] } } },
  "vectors": [
    { "id": "MV-01", "name": "ever 규칙 같은 사건 2번 → 적립 1줄",
      "given": { "rules": [{ "id": "mru_signup", "trigger": "signup", "nature": "participation", "once": "ever", "score": { "mode": "fixed", "v": 100 } }] },
      "steps": [
