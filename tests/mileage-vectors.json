        { "op": "emit", "args": { "trigger": "signup", "srcType": "acct", "srcId": "s1", "trust": "A", "at": "2026-11-02T10:01:00+09:00" }, "expect": { "status": "already" } },
        { "op": "emit", "args": { "trigger": "signup", "srcType": "acct", "srcId": "s1b", "trust": "A", "at": "2026-11-02T10:02:00+09:00" }, "expect": { "status": "skipped", "reason": "already" } }
      ], "then": { "wallets": { "s1|lu_root": { "balance": 100, "convertible": 0 } } } },
