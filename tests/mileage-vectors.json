        { "op": "emit", "args": { "trigger": "course_done", "srcType": "cls", "srcId": "c1", "trust": "A", "at": "2026-11-02T10:01:00+09:00" } },
        { "op": "emit", "args": { "trigger": "exam_score", "srcType": "exam", "srcId": "1", "value": 90, "trust": "A", "at": "2026-11-02T10:02:00+09:00" } },
        { "op": "redeem", "args": { "reward": "mrw_goods", "points": 150, "idem": "a", "at": "2026-11-03T10:00:00+09:00" }, "expect": { "status": "approved", "wallet": { "balance": 150, "nextExpire": [{ "at": "2027-02-03T00:00:00+09:00", "points": 50 }, { "at": "2027-11-03T00:00:00+09:00", "points": 100 }] } } }
