        { "id": "mru_les2", "trigger": "lesson_done", "score": { "mode": "fixed", "v": 20 } }] },
      "steps": [
        { "op": "emit", "args": { "trigger": "lesson_done", "srcType": "item", "srcId": "c1/i1", "trust": "A", "at": "2026-11-02T10:00:00+09:00" }, "expect": { "status": "done", "entries": [{ "points": 30 }, { "points": 20 }] } },
        { "op": "emit", "args": { "trigger": "lesson_done", "srcType": "item", "srcId": "c1/i2", "trust": "A", "at": "2026-11-02T10:10:00+09:00" }, "expect": { "status": "done", "entries": [{ "points": 20 }, { "points": 10 }] } },
