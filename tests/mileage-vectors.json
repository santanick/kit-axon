        { "op": "emit", "args": { "trigger": "exam_score", "srcType": "exam", "srcId": "c1/q1#2", "value": 95, "trust": "A", "at": "2026-11-03T10:00:00+09:00" }, "expect": { "status": "done", "entries": [{ "points": 50 }] } },
        { "op": "emit", "args": { "trigger": "exam_score", "srcType": "exam", "srcId": "c1/q1#3", "value": 80, "trust": "A", "at": "2026-11-04T10:00:00+09:00" }, "expect": { "status": "skipped", "reason": "already" } },
        { "op": "emit", "args": { "trigger": "exam_score", "srcType": "exam", "srcId": "c1/q2#1", "value": 70, "trust": "A", "at": "2026-11-04T11:00:00+09:00" }, "expect": { "status": "skipped", "reason": "cond" } }
      ], "then": { "wallets": { "s1|lu_root": { "balance": 100 } } } },
    { "id": "MV-06", "name": "승인 필요 적립 pending: 잔액 제외 · 만료 시계 없음 → 승인 시 만료일 계산",
