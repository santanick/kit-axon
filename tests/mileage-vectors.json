      "steps": [
        { "op": "emit", "args": { "trigger": "attend_day", "srcType": "day", "srcId": "2026-11-02", "value": 30, "trust": "A", "at": "2026-11-02T23:59:00+09:00" }, "expect": { "status": "done" } },
        { "op": "emit", "args": { "trigger": "attend_day", "srcType": "day", "srcId": "2026-11-03", "value": 30, "trust": "A", "at": "2026-11-03T00:00:00+09:00" }, "expect": { "status": "done" } },
        { "op": "emit", "args": { "trigger": "attend_day", "srcType": "day", "srcId": "2026-11-03b", "value": 30, "trust": "A", "at": "2026-11-03T09:00:00+09:00" }, "expect": { "status": "skipped", "reason": "already" } },
        { "op": "emit", "args": { "trigger": "attend_day", "srcType": "day", "srcId": "2026-11-04", "value": 5, "trust": "A", "at": "2026-11-04T09:00:00+09:00" }, "expect": { "status": "skipped", "reason": "cond" } }
      ], "then": { "wallets": { "s1|lu_root": { "balance": 20 } } } },
