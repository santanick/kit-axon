        { "op": "emit", "args": { "trigger": "evidence", "srcType": "pf", "srcId": "2", "cls": "lang", "trust": "B", "at": "2026-11-03T10:00:00+09:00" }, "expect": { "status": "done", "entries": [{ "points": 40, "ruleId": "mru_lang" }] } },
        { "op": "emit", "args": { "trigger": "evidence", "srcType": "pf", "srcId": "3", "cls": "cert", "trust": "B", "at": "2026-11-04T10:00:00+09:00" }, "expect": { "status": "skipped", "reason": "group_cap" } },
        { "op": "emit", "args": { "trigger": "evidence", "srcType": "pf", "srcId": "4", "cls": "cert", "trust": "B", "at": "2027-03-02T10:00:00+09:00" }, "expect": { "status": "done", "entries": [{ "points": 60 }] } }
