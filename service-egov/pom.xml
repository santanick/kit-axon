<?xml version="1.0" encoding="UTF-8"?>
<!-- 디디쌤 운영 서버 — 전자정부 표준프레임워크 에디션(시범 이식, v29.1)
     Node 서버(service/server)와 같은 API 규격 · 같은 PostgreSQL 스키마를 쓴다. 화면은 그대로 재사용한다.
     빌드 프로필:
       - (기본) local : Maven Central만으로 빌드. 표준프레임워크 실행환경(RTE) 클래스는 같은 이름의 호환 shim(src/main/java/org/egovframe)으로 대신한다.
       - egov        : 기관 반입 빌드. shim을 빼고 실제 표준프레임워크 5.0 실행환경(maven.egovframe.go.kr)을 쓴다.  mvn -Pegov package -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>
  <groupId>egovframework.didisam</groupId>
  <artifactId>didisam-egov</artifactId>
  <version>29.1.0</version>
  <name>didisam-egov</name>
  <!-- war: java -jar 실행과 외장 WAS(Tomcat · JEUS 등) 배포를 모두 지원, JSP 화면 포함 -->
  <packaging>war</packaging>
  <properties>
    <java.version>17</java.version>
    <egovframe.version>5.0.2</egovframe.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- 표준프레임워크 실행환경 호환 shim 소스 위치. -Pegov에서는 비워서 실제 RTE만 쓴다 -->
    <shim.dir>src/shim/java</shim.dir>
  </properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.mybatis.spring.boot</groupId><artifactId>mybatis-spring-boot-starter</artifactId><version>3.0.5</version></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-tomcat</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.tomcat.embed</groupId><artifactId>tomcat-embed-jasper</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>jakarta.servlet.jsp.jstl</groupId><artifactId>jakarta.servlet.jsp.jstl-api</artifactId></dependency>
    <dependency><groupId>org.glassfish.web</groupId><artifactId>jakarta.servlet.jsp.jstl</artifactId></dependency>
    <dependency><groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId><version>1.81</version></dependency>
  </dependencies>
  <build>
    <finalName>didisam-egov</finalName>
    <plugins>
      <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId>
        <executions><execution><id>shim</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals>
          <configuration><sources><source>${shim.dir}</source></sources></configuration></execution></executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>egov</id>
      <repositories>
        <repository><id>egovframe</id><url>https://maven.egovframe.go.kr/maven/</url></repository>
      </repositories>
      <dependencies>
        <!-- 실제 표준프레임워크 실행환경(artifactId는 5.x 규칙: egovframe-rte-*).
             RTE가 끌어오는 log4j-slf4j2-impl은 Spring Boot 기본 로깅(log4j-to-slf4j)과 충돌해 기동이 실패하므로 제외(2026-11-05 실제 RTE 기동 확인) -->
        <dependency><groupId>org.egovframe.rte</groupId><artifactId>egovframe-rte-fdl-cmmn</artifactId><version>${egovframe.version}</version><exclusions><exclusion><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-slf4j2-impl</artifactId></exclusion></exclusions></dependency>
        <dependency><groupId>org.egovframe.rte</groupId><artifactId>egovframe-rte-fdl-property</artifactId><version>${egovframe.version}</version><exclusions><exclusion><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-slf4j2-impl</artifactId></exclusion></exclusions></dependency>
        <dependency><groupId>org.egovframe.rte</groupId><artifactId>egovframe-rte-fdl-idgnr</artifactId><version>${egovframe.version}</version><exclusions><exclusion><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-slf4j2-impl</artifactId></exclusion></exclusions></dependency>
        <dependency><groupId>org.egovframe.rte</groupId><artifactId>egovframe-rte-psl-dataaccess</artifactId><version>${egovframe.version}</version><exclusions><exclusion><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-slf4j2-impl</artifactId></exclusion></exclusions></dependency>
        <dependency><groupId>org.egovframe.rte</groupId><artifactId>egovframe-rte-ptl-mvc</artifactId><version>${egovframe.version}</version><exclusions><exclusion><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-slf4j2-impl</artifactId></exclusion></exclusions></dependency>
      </dependencies>
      <properties><shim.dir>src/shim/none</shim.dir></properties>
    </profile>
  </profiles>
</project>
