<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="egovframework.didisam.cmm.TenantTxMapper">
  <update id="setTenantRole">set local role didisam_tenant</update>
  <select id="setTenant" resultType="string">select set_config('app.tenant', #{tid}, true)</select>
  <insert id="insertAudit">insert into audit_log (tenant_id, actor, action, detail) values (#{tid}, #{actor}, #{action}, cast(#{detail} as jsonb))</insert>
</mapper>
