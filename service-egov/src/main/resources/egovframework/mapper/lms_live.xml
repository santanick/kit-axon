<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- x2 실시간 수업 · 자막: 업무 함수(sql/a2_live.sql)를 부른다. 함수 이름은 고정 라우트 표에서만(${fn}) -->
<mapper namespace="egovframework.didisam.lms.live.service.impl.LmsLiveMapper">
  <select id="call" resultType="string" flushCache="true" useCache="false">select ${fn}(cast(#{ctx} as jsonb), cast(#{a} as jsonb))::text</select>
</mapper>
