rules_version = '2';
// KIT AX ON — Firestore 보안 규칙
// students(학번 · 해시) · approvals 쓰기 · messages · badgeLog · auditLog · admins · catalogPrivate 는 Cloud Functions 전용
service cloud.firestore {
  match /databases/{database}/documents {
    function isStudent(sid) { return request.auth != null && request.auth.uid == 's_' + sid; }

    // 학생 진도: 본인만 읽기 · 쓰기, 필드는 p · updatedAt 만 허용
    match /progress/{sid} {
      allow read: if isStudent(sid);
      allow write: if isStudent(sid)
        && request.resource.data.keys().hasOnly(['p', 'updatedAt'])
        && request.resource.data.p is map
        && request.resource.data.updatedAt == request.time;
    }
    // 평가 · 배지 · 관리자 진도 처리 결과: 본인 읽기만
    match /approvals/{sid} {
      allow read: if isStudent(sid);
      allow write: if false;
    }
    // 코스웨어 · 공지 · 배지 정의(공개 설정): 누구나 읽기, 쓰기는 saveCatalog 함수만
    match /catalog/main {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
